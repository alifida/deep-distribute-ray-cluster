# Shared cluster configuration used by Linux (.sh) and Windows (.ps1/.bat) scripts.
# Adjust these values for your environment.

# Required for worker scripts when no CLI arg is passed.
HEAD_IP=192.168.18.99
HEAD_PORT=6379

# Ray head and dashboard
RAY_PORT=6379
DASHBOARD_PORT=8265
RESTART_RAY=0

# Resource defaults
NUM_GPUS=1
HOST=0.0.0.0
PORT=8080

# Head fixed ports
NODE_MANAGER_PORT=10001
OBJECT_MANAGER_PORT=10002
RAY_CLIENT_SERVER_PORT=10003
DASHBOARD_AGENT_LISTEN_PORT=10004
METRICS_EXPORT_PORT=10005
MIN_WORKER_PORT=11000
MAX_WORKER_PORT=11999

# Worker fixed ports
WORKER_NODE_MANAGER_PORT=10011
WORKER_OBJECT_MANAGER_PORT=10012
WORKER_DASHBOARD_AGENT_LISTEN_PORT=10014
WORKER_METRICS_EXPORT_PORT=10015
WORKER_MIN_WORKER_PORT=12000
WORKER_MAX_WORKER_PORT=12999
